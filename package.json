{
  "name": "burkut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "release:cpanel": "node scripts/release-cpanel.mjs",
    "release:full": "node scripts/release-full.mjs",
    "server:dev": "node server/dev.mjs",
    "qa:prepare": "npm run build && node scripts/prepare-performance.mjs",
    "qa:preview": "vite preview --host 127.0.0.1 --outDir .qa-dist --port 4173 --strictPort",
    "check:assets": "node scripts/check-assets.mjs",
    "check:site": "node scripts/check-site.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --maxWorkers=2",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
