# Vite-generated filenames carry an 8-character content hash.
# A new build changes the URL, so only these assets can be cached for a year.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/css application/javascript text/javascript
  </IfModule>
</IfModule>
